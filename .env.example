# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
#
# Used in two ways:
#   1. `npm run dev` (services on your machine): read via node --env-file
#   2. `docker compose up`: values are interpolated into docker-compose.yml

NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL (one database per service) ────
POSTGRES_PASSWORD=password
AUTH_DB_URL=postgresql://postgres:password@localhost:5435/authdb
ORDER_DB_URL=postgresql://postgres:password@localhost:5432/orderdb
INVENTORY_DB_URL=postgresql://postgres:password@localhost:5433/inventorydb
PAYMENT_DB_URL=postgresql://postgres:password@localhost:5434/paymentdb

# ── Redis / RabbitMQ ─────────────────────────
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Auth ─────────────────────────────────────
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# auth-service: RSA private key that signs access tokens (create with `npm run keys:generate`).
# Path is relative to the service folder when running `npm run dev`.
JWT_PRIVATE_KEY_FILE=../../secrets/jwt-private.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Optional: seed an admin account on startup (password: 12+ characters). Leave empty to skip.
ADMIN_EMAIL=admin@bookwise.local
ADMIN_PASSWORD=change-me-admin-password

# ── Service ports / URLs (local dev) ─────────
GATEWAY_PORT=3000
ORDER_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
AUTH_SERVICE_PORT=3004
AUTH_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
