{
  "name": "bookwise",
  "version": "1.0.0",
  "description": "Distributed Multi-Vendor Booking Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w packages/common && npm run build -w services",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "npm run migrate --workspaces --if-present",
    "infra:up": "docker compose up -d order-db inventory-db payment-db redis rabbitmq",
    "up": "docker compose up --build -d",
    "down": "docker compose down"
  },
  "keywords": [],
  "author": "Avinash Birajdar",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
