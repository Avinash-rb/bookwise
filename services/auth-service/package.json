{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "BookWise Auth Service: users, password hashing, token issuing",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=../../.env --conditions=development src/migrate.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@bookwise/common": "*",
    "fast-jwt": "^6.3.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "typebox": "^1.3.34",
    "zod": "^4.6.5"
  }
}
